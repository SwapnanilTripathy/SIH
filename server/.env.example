# Copy this file to .env and fill in real values before deploying anywhere
# other than your own machine.

PORT=4000

# Any long random string. Used to sign auth JWTs — if this leaks, anyone
# can forge a valid login token.
JWT_SECRET=change-this-before-deploying-anywhere-real

# How long an issued token stays valid. Accepts values like "1h", "7d".
JWT_EXPIRES_IN=7d
